# ==============================================================================
# FashionPulse AI — Environment Variables Configuration
# Copy this file to .env and fill in your genuine credentials when available.
# Safe defaults are provided for running in local demonstration mode.
# ==============================================================================

PROJECT_NAME=FashionPulse AI
VERSION=1.0.0
ENVIRONMENT=development

# Database Settings
# For local SQLite development:
DATABASE_URL=sqlite+aiosqlite:///./fashionpulse.db
SYNC_DATABASE_URL=sqlite:///./fashionpulse.db
# For PostgreSQL (Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:fashionpulse_secret@localhost:5432/fashionpulse
# SYNC_DATABASE_URL=postgresql://postgres:fashionpulse_secret@localhost:5432/fashionpulse

# ------------------------------------------------------------------------------
# 1. Reddit for Researchers (RFR) — Google BigQuery Analytics Hub (BQAH)
# Portal: https://support.reddithelp.com/hc/en-us/articles/16160319875092-Reddit-Data-API-Wiki
# NOTE: Disabled by default. Academic research using Reddit data must be conducted through
# the official Reddit for Researchers (RFR) program via Google BigQuery Analytics Hub (BQAH).
# Ordinary OAuth Data API credentials do NOT grant academic research access.
# Data Availability & Cadence: 5-year rolling lookback, 6-month historical lag, monthly batch refresh.
# NOT real-time. Content must NOT be used for AI/LLM model training without explicit consent.
# Set ENABLE_REDDIT_RFR_INGESTION=true only after receiving RFR approval and BigQuery linked access.
# ------------------------------------------------------------------------------
ENABLE_REDDIT_RFR_INGESTION=false
RFR_GCP_PROJECT_ID=your-gcp-project-id-here
RFR_DATASET_NAME=your_rfr_subscriber_dataset_here
RFR_TABLE_NAME=posts
RFR_CREDENTIALS_PATH=

# ------------------------------------------------------------------------------
# 2. Instagram API Connector (Meta Graph API v26.0)
# Portal: https://developers.facebook.com/apps/
# Requires 'Instagram Public Content Access' (IPCA) feature approval + IG Business Account ID.
# Note: Upgrading version does NOT grant access to restricted IPCA feature.
# ------------------------------------------------------------------------------
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_ACCESS_TOKEN=your_meta_system_user_or_page_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_APP_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 Connector
# Portal: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here

# ------------------------------------------------------------------------------
# 4. NVIDIA Nemotron Model Downstream Handoff
# ------------------------------------------------------------------------------
NEMOTRON_ENDPOINT_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL_NAME=nvidia/nemotron-4-340b-instruct
NEMOTRON_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Pipeline & Scoring Engine Weights
# ------------------------------------------------------------------------------
ENABLE_DEMO_DATA_FALLBACK=true
COLLECTION_INTERVAL_MINUTES=60
WEIGHT_FREQUENCY=0.30
WEIGHT_MOMENTUM=0.25
WEIGHT_ENGAGEMENT=0.20
WEIGHT_CROSS_PLATFORM=0.15
WEIGHT_RECENCY=0.10
MIN_OBSERVATION_THRESHOLD=3
